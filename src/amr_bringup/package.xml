<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_bringup</name>
  <version>0.1.0</version>
  <description>Top-level bringup launch for simulation, control, sensors, localization, and navigation.</description>
  <maintainer email="s.ganbat24@gmail.com">Ganbat Selenge</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>amr_description</depend>
  <depend>amr_control</depend>
  <depend>amr_sensors</depend>
  <depend>amr_simulation</depend>
  <depend>amr_localization</depend>
  <depend>amr_navigation</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
