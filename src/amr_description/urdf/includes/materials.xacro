<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="chassis_color">
    <color rgba="0.15 0.4 0.7 1.0"/>
  </material>

  <material name="wheel_color">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="caster_color">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>

  <material name="lidar">
    <color rgba="0.2 0.2 0.22 1.0"/>
  </material>

  <material name="lidar_lens">
    <color rgba="0.05 0.1 0.25 1.0"/>
  </material>

  <material name="camera">
    <color rgba="0.22 0.22 0.22 1.0"/>
  </material>

  <material name="camera_lens">
    <color rgba="0.05 0.05 0.18 1.0"/>
  </material>

  <material name="imu_color">
    <color rgba="0.85 0.25 0.0 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

</robot>
