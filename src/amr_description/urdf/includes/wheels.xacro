<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="drive_wheel" params="side reflect">
    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${side}_link"/>
      <origin xyz="0 ${reflect * wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="${wheel_effort}" velocity="${wheel_velocity}"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>
    <link name="wheel_${side}_link">
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${(wheel_mass/12) * (3*wheel_radius**2 + wheel_length**2)}"
          ixy="0.0" ixz="0.0"
          iyy="${0.5 * wheel_mass * wheel_radius**2}"
          iyz="0.0"
          izz="${(wheel_mass/12) * (3*wheel_radius**2 + wheel_length**2)}"/>
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <material name="wheel_color"/>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      </collision>
    </link>
  </xacro:macro>

</robot>
