<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="diff_drive" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="wheel_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <transmission name="wheel_left_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint>wheel_left_joint</joint>
    <actuator name="wheel_left_actuator"/>
    <mechanicalReduction>1</mechanicalReduction>
  </transmission>

  <transmission name="wheel_right_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint>wheel_right_joint</joint>
    <actuator name="wheel_right_actuator"/>
    <mechanicalReduction>1</mechanicalReduction>
  </transmission>

</robot>
